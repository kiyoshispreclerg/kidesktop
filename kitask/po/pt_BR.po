#: kitask.c:464
#, c-format
msgid ""
"kitask %s - process list and system monitor\n"
"\n"
"Usage: kitask [OPTION]...\n"
"  -f, --filter TEXT    start with TEXT in the filter\n"
"  -h, --help           show this help\n"
"  -v, --version        show the version\n"
msgstr ""
"kitask %s - lista de processos e monitor do sistema\n"
"\n"
"Uso: kitask [OPÇÃO]...\n"
"  -f, --filter TEXTO   começa com TEXTO no filtro\n"
"  -h, --help           mostra esta ajuda\n"
"  -v, --version        mostra a versão\n"

