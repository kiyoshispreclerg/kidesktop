#: src/main.c:1109
msgid "compositor for kiwm"
msgstr "compositor para o kiwm"

#: src/main.c:1110
msgid ""
"usage: kicomp [--replace] [--toggle] [--single-drawable]\n"
"              [--skip-wm-layers]\n"
"              [--effects|--no-effects] [--anim-ms=N]\n"
"              [--renderer=NAME] [--presenter=NAME]\n"
"              [-v|--verbose] [--version] [--help]"
msgstr "uso: kicomp [--replace] [--toggle] [--single-drawable]\n              [--skip-wm-layers]\n              [--effects|--no-effects] [--anim-ms=N]\n              [--renderer=NAME] [--presenter=NAME]\n              [-v|--verbose] [--version] [--help]"

#: src/main.c:1116
msgid "take over from a running compositor"
msgstr "toma o lugar de um compositor em execução"

#: src/main.c:1117
