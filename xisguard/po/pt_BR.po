#: xisguard.c:122
msgid "Access clipboard"
msgstr "Acessar área de transferência"

#: xisguard.c:123
msgid "Access other windows"
msgstr "Acessar outras janelas"

#: xisguard.c:124
msgid "Capture and draw to the screen"
msgstr "Capturar e desenhar na tela"

#: xisguard.c:125
msgid "Record events - like keystrokes"
msgstr "Gravar eventos - como teclas"

#: xisguard.c:126
msgid "Access cursor (mouse) image and position"
msgstr "Acessar imagem/posição do cursor (mouse)"

#: xisguard.c:127
