#!/bin/sh
# configure - dependency check for a KiDesktop build.
#
#   ./configure               core + base applications (the default)
#   ./configure --core-only   core only (no kiterm, kifiles, ...)
#   ./configure --with-base   core + base, explicitly
#
# The choice is written to config.mk, which the Makefile reads; a plain
# `make install` then builds just what was asked for.
#
# Run this before `make install` (from the project root, it runs
# automatically as a prerequisite -- see Makefile). It only checks that the
# libraries shared across the suite are present; each component still finds
# its own optional dependencies itself (e.g. dbus-1 for tray/globalmenu
# support in xispanel/xisserve) and degrades or fails on its own.
#
# Building a single component on its own -- `make -C kiconf install`, say --
# does not need this script: that component's Makefile only pulls in what
# it personally links against.
set -e

WITH_BASE=1
for arg in "$@"; do
	case "$arg" in
	--core-only|--without-base) WITH_BASE=0 ;;
	--with-base) WITH_BASE=1 ;;
	-h|--help) sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	*) echo "configure: unknown option '$arg' (try --help)" >&2; exit 2 ;;
	esac
done
printf 'WITH_BASE = %s\n' "$WITH_BASE" > config.mk

MISSING=0

check() {
	pkg="$1"
	label="${2:-$1}"
	if pkg-config --exists "$pkg" 2>/dev/null; then
		printf '  [ok]      %-10s (%s)\n' "$label" "$(pkg-config --modversion "$pkg")"
	else
		printf '  [MISSING] %-10s (pkg-config: %s)\n' "$label" "$pkg"
		MISSING=1
	fi
}

if [ "$WITH_BASE" = 1 ]; then
	echo "Checking dependencies for KiDesktop core + base..."
else
	echo "Checking dependencies for KiDesktop core only..."
fi
echo

check cairo
check pango
check imlib2
check dbus-1 dbus
check gtk+-2.0 gtk2
check xres XRes

# kitheme's Qt style plugin is built per Qt version found; without Qt
# development files GTK still gets the theme.
if pkg-config --exists Qt5Widgets 2>/dev/null; then
	printf '  [ok]      %-10s (%s)\n' qt5 "$(pkg-config --modversion Qt5Widgets)"
else
	printf '  [skipped] %-10s (pkg-config: Qt5Widgets) -- no KiTheme style for Qt5 apps\n' qt5
fi
if [ -f "$(qmake6 -query QT_INSTALL_HEADERS 2>/dev/null)/QtWidgets/QStylePlugin" ]; then
	printf '  [ok]      %-10s (%s)\n' qt6 "$(qmake6 -query QT_VERSION)"
else
	printf '  [skipped] %-10s (qmake6, qt6-base-dev) -- no KiTheme style for Qt6 apps\n' qt6
fi

# kiterm is the only component that needs VTE; without it the build
# skips kiterm instead of failing (see Makefile).
if [ "$WITH_BASE" = 1 ]; then
	if pkg-config --exists vte 2>/dev/null; then
		printf '  [ok]      %-10s (%s)\n' vte2.0 "$(pkg-config --modversion vte)"
	else
		printf '  [skipped] %-10s (pkg-config: vte) -- kiterm will NOT be built\n' vte2.0
		echo "  warning: install libvte-dev (the GTK2 one) to build kiterm"
	fi
fi

# kishot records through a plugin built only with the FFmpeg libraries;
# without them it falls back to the ffmpeg command at runtime.
if [ "$WITH_BASE" = 1 ]; then
	if pkg-config --exists libavcodec libavformat libavfilter libavutil 2>/dev/null; then
		printf '  [ok]      %-10s (%s)\n' libav "$(pkg-config --modversion libavcodec)"
	else
		printf '  [skipped] %-10s (pkg-config: libavcodec libavformat libavfilter libavutil) -- kishot without its recording plugin\n' libav
	fi
fi

echo

if [ "$MISSING" -ne 0 ]; then
	echo "Missing dependencies listed above -- install them, then re-run ./configure."
	echo "(Debian/Ubuntu: libcairo2-dev libpango1.0-dev libimlib2-dev libdbus-1-dev libgtk2.0-dev libxres-dev; optional: libvte-dev for kiterm)"
	echo
	echo "To build just one component instead, skip this script and run"
	echo "'make -C <component>' -- it only needs that component's own dependencies."
	exit 1
fi

if [ "$WITH_BASE" = 1 ]; then
	echo "All dependencies found. Run 'make install' to build and install KiDesktop (core + base)."
else
	echo "All dependencies found. Run 'make install' to build and install KiDesktop core."
fi
