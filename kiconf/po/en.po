#: tabs/acessibilidade.c:452
msgid ""
"Teclas de aderencia: Shift, Ctrl e Alt ficam pressionados ate a proxima tecla"
msgstr "Sticky keys: Shift, Ctrl and Alt stay pressed until the next key"

#: tabs/acessibilidade.c:455
msgid "Desativar a aderencia ao pressionar duas teclas juntas"
msgstr "Turn sticky keys off when two keys are pressed together"

#: tabs/acessibilidade.c:458
msgid "Teclas lentas: so aceitar teclas mantidas pressionadas"
msgstr "Slow keys: only accept keys held down"

#: tabs/acessibilidade.c:462
msgid "Tempo para aceitar (ms):"
msgstr "Accept after (ms):"

#: tabs/acessibilidade.c:463
msgid "Teclas de repercussao: ignorar toques repetidos rapidos"
msgstr "Bounce keys: ignore fast repeated presses"

#: tabs/acessibilidade.c:467
