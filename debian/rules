#!/usr/bin/make -f
# kidesktop-core and kidesktop-base both come from the top-level Makefile,
# which builds every component (see ../Makefile) and installs each group
# into its own package.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# ./configure only checks dependencies (Build-Depends already did), and
# the CMakeLists.txt at the root is the old Qt prototype, not part of the
# package -- dh would otherwise try to run one of them.
override_dh_auto_configure:

override_dh_auto_build:
	$(MAKE) PREFIX=/usr

override_dh_auto_install:
	$(MAKE) install-core PREFIX=/usr DESTDIR=$(CURDIR)/debian/kidesktop-core
	$(MAKE) install-base PREFIX=/usr DESTDIR=$(CURDIR)/debian/kidesktop-base

override_dh_auto_test:

override_dh_auto_clean:
	$(MAKE) clean
