#!/usr/bin/make -f
# kidesktop-core and kidesktop-base both come from the top-level Makefile,
# which builds every component (see ../Makefile) and installs each group
# into its own package.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# ./configure only checks dependencies (Build-Depends already did), and
# the CMakeLists.txt at the root is the old Qt prototype, not part of the
# package -- dh would otherwise try to run one of them.
override_dh_auto_configure:

override_dh_auto_build:
	$(MAKE) PREFIX=/usr

override_dh_auto_install:
	$(MAKE) install-core PREFIX=/usr DESTDIR=$(CURDIR)/debian/kidesktop-core
	$(MAKE) install-base PREFIX=/usr DESTDIR=$(CURDIR)/debian/kidesktop-base

# kishot's libav plugin is optional (dlopen()ed, kishot falls back to the
# ffmpeg command or only takes screenshots): its libraries go to Recommends,
# not Depends.
# kitheme's Qt style plugins link Qt, but only Qt applications ever load
# them (and those have Qt), so they must not make the core depend on it:
# excluded from kidesktop-core's dependency scan.
override_dh_shlibdeps:
	dh_shlibdeps -Nkidesktop-base -Xqt5/plugins/styles -Xqt6/plugins/styles
	dh_shlibdeps -pkidesktop-base -Xkishot-rec-av.so -- \
		-dRecommends debian/kidesktop-base/usr/lib/kishot/kishot-rec-av.so -dDepends

override_dh_auto_test:

override_dh_auto_clean:
	$(MAKE) clean
