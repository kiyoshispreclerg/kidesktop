#: kiconfd.c:1761 kiconfd.c:1809
msgid "Luz noturna desativada"
msgstr "Night light disabled"

#: kiconfd.c:1800
msgid "Luz noturna ativada"
msgstr "Night light enabled"

#: kiconfd.c:2013
msgid "session settings daemon for KiDesktop"
msgstr "session settings daemon for KiDesktop"

#: kiconfd.c:2014
msgid "Usage: kiconfd [--log|--version|-V]"
msgstr "Usage: kiconfd [--log|--version|-V]"

#: kiconfd.c:2015
msgid "Config: $XDG_CONFIG_HOME/kiconfd.conf (fallback ~/.config/kiconfd.conf)"
msgstr "Config: $XDG_CONFIG_HOME/kiconfd.conf (fallback ~/.config/kiconfd.conf)"

#: kiconfd.c:2016
msgid ""
"Screens: $XDG_CONFIG_HOME/kiconfd-screens.conf, applied via xrandr at "
"startup only"
msgstr "Screens: $XDG_CONFIG_HOME/kiconfd-screens.conf, applied via xrandr at startup only"

#: kiconfd.c:2017
msgid ""
"Input: $XDG_CONFIG_HOME/kiconfd-input.conf (NumLock-on-start + XiS keyboard "
"flags), applied at startup and on SIGHUP"
msgstr "Input: $XDG_CONFIG_HOME/kiconfd-input.conf (NumLock-on-start + XiS keyboard flags), applied at startup and on SIGHUP"

#: kiconfd.c:2019
#, c-format
msgid ""
"Night light: $XDG_CONFIG_HOME/kiconfd-nightlight.conf, applied via xsct "
"every %ds (if installed)\n"
msgstr "Night light: $XDG_CONFIG_HOME/kiconfd-nightlight.conf, applied via xsct every %ds (if installed)\n"

#: kiconfd.c:2021
msgid ""
"Log: off by default (inherits stdout/stderr as usual). --log, or "
"KICONFD_LOG=1 in the environment, redirects them to $XDG_CONFIG_HOME/kiconfd."
"log instead."
msgstr "Log: off by default (inherits stdout/stderr as usual). --log, or KICONFD_LOG=1 in the environment, redirects them to $XDG_CONFIG_HOME/kiconfd.log instead."

#: kiconfd.c:2023
msgid "SIGHUP reloads the config and reapplies settings."
msgstr "SIGHUP reloads the config and reapplies settings."