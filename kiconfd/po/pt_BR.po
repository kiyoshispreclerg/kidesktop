#: kiconfd.c:1761 kiconfd.c:1809
msgid "Luz noturna desativada"
msgstr "Luz noturna desativada"

#: kiconfd.c:1800
msgid "Luz noturna ativada"
msgstr "Luz noturna ativada"

#: kiconfd.c:2013
msgid "session settings daemon for KiDesktop"
msgstr "daemon de configurações de sessão do KiDesktop"

#: kiconfd.c:2014
msgid "Usage: kiconfd [--log|--version|-V]"
msgstr "Uso: kiconfd [--log|--version|-V]"

#: kiconfd.c:2015
msgid "Config: $XDG_CONFIG_HOME/kiconfd.conf (fallback ~/.config/kiconfd.conf)"
msgstr "Config: $XDG_CONFIG_HOME/kiconfd.conf (ou ~/.config/kiconfd.conf)"

#: kiconfd.c:2016
msgid ""
"Screens: $XDG_CONFIG_HOME/kiconfd-screens.conf, applied via xrandr at "
"startup only"
msgstr "Telas: $XDG_CONFIG_HOME/kiconfd-screens.conf, aplicado via xrandr só na inicialização"

#: kiconfd.c:2017
msgid ""
"Input: $XDG_CONFIG_HOME/kiconfd-input.conf (NumLock-on-start + XiS keyboard "
"flags), applied at startup and on SIGHUP"
msgstr "Entrada: $XDG_CONFIG_HOME/kiconfd-input.conf (NumLock ao iniciar + flags de teclado do XiS), aplicado na inicialização e no SIGHUP"

#: kiconfd.c:2019
#, c-format
msgid ""
"Night light: $XDG_CONFIG_HOME/kiconfd-nightlight.conf, applied via xsct "
"every %ds (if installed)\n"
msgstr "Luz noturna: $XDG_CONFIG_HOME/kiconfd-nightlight.conf, aplicado via xsct a cada %ds (se instalado)\n"

#: kiconfd.c:2021
msgid ""
"Log: off by default (inherits stdout/stderr as usual). --log, or "
"KICONFD_LOG=1 in the environment, redirects them to $XDG_CONFIG_HOME/kiconfd."
"log instead."
msgstr "Log: desligado por padrão (herda stdout/stderr como de costume). --log, ou KICONFD_LOG=1 no ambiente, redireciona para $XDG_CONFIG_HOME/kiconfd.log em vez disso."

#: kiconfd.c:2023
msgid "SIGHUP reloads the config and reapplies settings."
msgstr "SIGHUP recarrega a configuração e reaplica as definições."